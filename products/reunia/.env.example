APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
AWS_REGION=us-west-2

# Core DynamoDB tables. Every table name must be configured explicitly; the
# application never derives a table name from APP_ENV or any other prefix.
USERS_TABLE_NAME=dev_meeting_users
TRANSCRIPTS_TABLE_NAME=dev_meeting_transcripts

# User-facing model presets. Change these IDs to models enabled for your account.
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_BALANCED=gpt-5.4-mini
AI_MODEL_ADVANCED=gpt-5.4
DEFAULT_AI_MODEL_PRESET=fast
# Runtime fallback for users who do not yet have a saved model preference.
DEFAULT_AI_MODEL=gpt-4o-mini
# Restrict regular user requests to the Fast preset. Set balanced or advanced only when intended.
AI_MAX_MODEL_PRESET=fast
OPENAI_API_KEY=

# Optional analytics price overrides. Text prices are USD per 1 million tokens;
# transcription prices are USD per audio minute. Leave blank to use the built-in
# model-specific defaults.
# ANALYTICS_AI_PRICING_JSON={"gpt-4o-mini":{"input":0.15,"cached_input":0.075,"output":0.60}}
# ANALYTICS_TRANSCRIPTION_PRICING_JSON={"whisper-1":0.006}

# Browser Recorder
# Final transcription keeps whisper-1 for timestamped segments. Short optional
# Live Q&A windows use the lower-cost model and do not request timestamps.
FINAL_TRANSCRIPTION_MODEL=whisper-1
LIVE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Backward-compatible alias; FINAL_TRANSCRIPTION_MODEL takes precedence.
AUDIO_TRANSCRIPTION_MODEL=whisper-1
# Set to a BCP-47/ISO language code such as en or fr. Leave blank for auto-detection.
AUDIO_TRANSCRIPTION_LANGUAGE=en
# Browser-recorder transcript quality safeguards.
RECORDER_NO_SPEECH_PROBABILITY_THRESHOLD=0.60
RECORDER_HIGH_NO_SPEECH_PROBABILITY_THRESHOLD=0.80
RECORDER_MIN_AVG_LOGPROB=-1.0
RECORDER_VERY_LOW_AVG_LOGPROB=-1.5
RECORDER_MAX_COMPRESSION_RATIO=2.4
RECORDER_REPEAT_MIN_WORDS=5
RECORDER_REPEAT_ALLOW_COUNT=1
RECORDER_REPEAT_TRIGGER_COUNT=3
RECORDER_REPEAT_WINDOW_SECONDS=180
# Maximum bytes accepted for each independently playable audio segment. Keep this
# below the transcription provider's per-request limit (default: 24,000,000 bytes).
RECORDER_MAX_FILE_BYTES=24000000
# The browser stops and restarts MediaRecorder every 10 minutes so long meetings
# are uploaded during recording rather than as one large file at the end.
RECORDER_FINAL_SEGMENT_SECONDS=600
RECORDER_FINAL_SEGMENT_RETRY_COUNT=3
RECORDER_FINAL_SEGMENT_RETRY_BASE_MILLISECONDS=1000
RECORDER_FINAL_MIN_SEGMENT_BYTES=800
# 18 ten-minute segments cap a recording at 3 hours per audio source.
RECORDER_MAX_SEGMENTS_PER_SOURCE=18
RECORDER_MAX_TOTAL_BYTES=750000000
# Maximum size of one HTTP request. Segmented requests remain well below this.
MAX_CONTENT_LENGTH=60000000
RECORDER_JOB_DIR=/tmp/meeting-assistant-recorder-jobs
RECORDER_JOB_RETENTION_SECONDS=86400
# Local development defaults. Production must use S3 + Redis.
RECORDER_JOB_STORAGE_BACKEND=local
RECORDER_JOB_QUEUE_BACKEND=inline
RECORDER_LIVE_STATE_BACKEND=memory
RECORDER_JOBS_BUCKET=
RECORDER_JOBS_S3_PREFIX=recorder-jobs
RECORDER_JOB_LEASE_SECONDS=120
RECORDER_JOB_IDEMPOTENCY_CHECK=true

# Optional browser-recorder Live Q&A windows. Users must explicitly enable this
# for each meeting. Basic voice activity detection skips silent windows.
RECORDER_LIVE_CHUNK_WINDOW_SECONDS=10
RECORDER_LIVE_CHUNK_INTERVAL_SECONDS=9
RECORDER_LIVE_QUEUE_LIMIT=3
RECORDER_LIVE_OVERLAP_MIN_WORDS=3
RECORDER_LIVE_SPEECH_LEVEL_THRESHOLD=8
RECORDER_LIVE_MIN_SPEECH_RATIO=0.08

# OpenAI cost safeguards. Set AI_ENABLED=false for an immediate emergency stop.
# A value of 0 disables an individual limit. Defaults are intentionally conservative.
AI_ENABLED=true
AI_GLOBAL_DAILY_BUDGET_USD=10
AI_GLOBAL_MONTHLY_BUDGET_USD=100
AI_USER_DAILY_BUDGET_USD=2
AI_USER_DAILY_TRANSCRIPTION_MINUTES=180
AI_LIVE_QA_MAX_MINUTES_PER_MEETING=60
AI_LIVE_QA_MAX_ANSWERS_PER_MEETING=25
AI_UNPRICED_TEXT_REQUEST_RESERVE_USD=0.05
AI_UNPRICED_TRANSCRIPTION_RESERVE_PER_MINUTE_USD=0.02
AI_MAX_OUTPUT_TOKENS_LIVE_QA=400
AI_MAX_OUTPUT_TOKENS_KNOWLEDGE_SEARCH=700
AI_MAX_OUTPUT_TOKENS_MEETING_ANALYSIS=2600
AI_COMBINE_MEETING_ANALYSIS_REQUESTS=true
AI_RESPONSE_CACHE_SECONDS=3600

# Persistent Real-Time Meeting Feed / Live Q&A storage.
# DynamoDB table schema: partition key `user_id` (String), sort key
# `entry_id` (String). Enable DynamoDB TTL on `expires_at`.
LIVE_QA_STORAGE_BACKEND=dynamodb
LIVE_QA_TABLE_NAME=dev_meeting_live_qa
# Refresh responsively while Live Q&A changes, then back off while the page is idle.
LIVE_QA_STREAM_ACTIVE_INTERVAL_SECONDS=2.0
LIVE_QA_STREAM_IDLE_INTERVAL_SECONDS=10.0
LIVE_QA_STREAM_ACTIVE_WINDOW_SECONDS=8.0
# Keep idle SSE connections healthy and detect closed/hidden tabs.
LIVE_QA_STREAM_HEARTBEAT_SECONDS=15.0
# Persist partial streaming answers at most once every two seconds.
LIVE_QA_PERSIST_INTERVAL_SECONDS=2.0
# Reuse recent DynamoDB query results across Live Q&A tabs in each worker.
LIVE_QA_DYNAMO_CACHE_TTL_SECONDS=2.0
# Optional alternative backend retained for development or migration.
REDIS_URL=redis://localhost:6379/0

# Signed external API token lifetime.
API_TOKEN_MAX_AGE_SECONDS=86400

# Optional migration switch. When true, API requests may authenticate with
# both user_id and password in their JSON body instead of a signed token.
ALLOW_PASSWORD_AUTH_IN_API_BODY=false

# Normally false: the server should select the model from the user's settings.
ALLOW_CLIENT_AI_MODEL_OVERRIDE=false

# Admin Analytics
# Comma-separated account email(s) allowed to open /admin/analytics.
ADMIN_USER_IDS=your-admin-email@example.com
# Create this table with scripts/create_admin_analytics_table.py.
# DynamoDB schema: partition key `session_key` (String).
ANALYTICS_STORAGE_BACKEND=dynamodb
ANALYTICS_TABLE_NAME=dev_meeting_app_analytics
# Do not count administrator usage in customer metrics.
ANALYTICS_EXCLUDE_ADMIN_ACTIVITY=true
ANALYTICS_HEARTBEAT_SECONDS=30
ANALYTICS_MAX_HEARTBEAT_SECONDS=60
ANALYTICS_IGNORE_BOTS=true
# Optional: configure only when a trusted reverse proxy overwrites this header
# with an ISO 3166-1 alpha-2 country code (for example CloudFront-Viewer-Country).
# Leave blank for direct-to-app traffic; client-supplied location headers are ignored.
ANALYTICS_GEO_COUNTRY_HEADER=
ANALYTICS_DATE_INDEX=analytics_date-index
ADMIN_ANALYTICS_CACHE_BACKEND=memory
ADMIN_ANALYTICS_CACHE_SECONDS=60
# Optional current model rates used for AI cost estimates.
ANALYTICS_AI_INPUT_COST_PER_MILLION=0
ANALYTICS_AI_OUTPUT_COST_PER_MILLION=0

# Action Center
# DynamoDB table schema: partition key `user_id` (String), sort key
# `action_id` (String). Use `memory` only for temporary local development.
ACTIONS_STORAGE_BACKEND=dynamodb
ACTIONS_TABLE_NAME=dev_meeting_actions

# Browser security and abuse protection
CSRF_ENABLED=true
RATE_LIMIT_STORAGE_BACKEND=memory
AUTH_LOGIN_RATE_LIMIT_COUNT=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_SIGNUP_RATE_LIMIT_COUNT=5
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_COUNT=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
# Password reset links expire after one hour by default.
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=3600
ANALYTICS_RATE_LIMIT_COUNT=180
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=3600
# Set to 1 for the single trusted Lightsail reverse-proxy hop.
TRUSTED_PROXY_HOPS=0

# Help & Support
# Support requests use DynamoDB by default in every non-test environment.
# Create a table whose partition key is `request_id` (String). Use `memory` only
# for temporary local development when persistence is not required.
SUPPORT_STORAGE_BACKEND=dynamodb
SUPPORT_REQUESTS_TABLE_NAME=dev_meeting_support_requests
SUPPORT_EMAIL=support@example.com
SUPPORT_RESPONSE_MESSAGE=We will review your message and reply as soon as possible.
SUPPORT_SUCCESS_MESSAGE=Your support request was sent successfully.
SUPPORT_RATE_LIMIT_COUNT=5
SUPPORT_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional: save support attachments in a private S3 bucket. If this is empty,
# users can submit requests but must remove any attachment first.
SUPPORT_ATTACHMENTS_BUCKET=
SUPPORT_MAX_ATTACHMENT_BYTES=5242880

# Optional: email a copy of each stored request to SUPPORT_EMAIL.
# Leave SUPPORT_SMTP_HOST empty to disable email notifications.
SUPPORT_FROM_EMAIL=support@example.com
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_SMTP_USE_TLS=true
SUPPORT_SMTP_USE_SSL=false

# Document Library
# Local development works without AWS using the defaults below.
# For production, use DynamoDB metadata plus a private S3 bucket.
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_FILE_STORAGE_BACKEND=local
KNOWLEDGE_LOCAL_METADATA_PATH=instance/knowledge/metadata.json
KNOWLEDGE_LOCAL_STORAGE_DIR=instance/knowledge/files
KNOWLEDGE_MAX_FILE_BYTES=10485760

# Lightsail production configuration. The application also uses this bucket
# as its production default, but setting it explicitly in Lightsail makes the
# deployment configuration visible and easy to change later.
# KNOWLEDGE_STORAGE_BACKEND=dynamodb
# KNOWLEDGE_TABLE_NAME=dev_meeting_knowledge
# KNOWLEDGE_FILE_STORAGE_BACKEND=s3
# KNOWLEDGE_FILES_BUCKET=meeting-assistant-documents-dev-usw2
# Optional: use the access-key pair created from the bucket's Permissions tab.
# Keeping these separate prevents a bucket-only key from replacing the normal
# AWS credentials that the application uses for DynamoDB.
# KNOWLEDGE_S3_ACCESS_KEY_ID=
# KNOWLEDGE_S3_SECRET_ACCESS_KEY=
# KNOWLEDGE_S3_SESSION_TOKEN=

# Public read-only meeting share links
MEETING_SHARES_STORAGE_BACKEND=dynamodb
MEETING_SHARES_TABLE_NAME=dev_meeting_share_links
# Local development alternative:
# MEETING_SHARES_STORAGE_BACKEND=local
# MEETING_SHARES_LOCAL_PATH=instance/meeting_shares.json

# ---------------------------------------------------------------------------
# Required Lightsail production values (set in the service, not in source).
# Production startup intentionally fails when any required value is missing.
# ---------------------------------------------------------------------------
# APP_ENV=production
# FLASK_SECRET_KEY=<at-least-32-random-characters>
# REDIS_URL=rediss://<managed-redis-endpoint>:6379/0
# TRUSTED_PROXY_HOPS=1
# USERS_TABLE_NAME=prod_meeting_users
# TRANSCRIPTS_TABLE_NAME=prod_meeting_transcripts
# ACTIONS_TABLE_NAME=prod_meeting_actions
# ANALYTICS_TABLE_NAME=prod_meeting_app_analytics
# MEETING_SHARES_TABLE_NAME=prod_meeting_share_links
# LIVE_QA_TABLE_NAME=prod_meeting_live_qa
# SUPPORT_REQUESTS_TABLE_NAME=prod_meeting_support_requests
# KNOWLEDGE_TABLE_NAME=prod_meeting_knowledge
# KNOWLEDGE_FILES_BUCKET=<private-production-document-bucket>
# RECORDER_JOBS_BUCKET=<private-production-recorder-bucket>
# RATE_LIMIT_STORAGE_BACKEND=redis
# ADMIN_ANALYTICS_CACHE_BACKEND=redis
# RECORDER_LIVE_STATE_BACKEND=redis
# RECORDER_JOB_STORAGE_BACKEND=s3
# RECORDER_JOB_QUEUE_BACKEND=redis
# RECORDER_JOB_IDEMPOTENCY_CHECK=true
# KNOWLEDGE_STORAGE_BACKEND=dynamodb
# KNOWLEDGE_FILE_STORAGE_BACKEND=s3
# ANALYTICS_STORAGE_BACKEND=dynamodb
# LIVE_QA_STORAGE_BACKEND=dynamodb
# ACTIONS_STORAGE_BACKEND=dynamodb
# SUPPORT_STORAGE_BACKEND=dynamodb
# MEETING_SHARES_STORAGE_BACKEND=dynamodb
# ALLOW_PASSWORD_AUTH_IN_API_BODY=false
